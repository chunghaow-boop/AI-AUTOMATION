# MEDIA STAYS OUT OF GIT — it syncs via Google Drive, not the repo.
# GitHub hard-limits files at 100MB and the refs library alone is 186MB.
# The repo carries CODE + PLANS + DOCS + LEDGERS: everything needed to
# rebuild any video once the media lands beside it.

assets/refs/
assets/bgm/
assets/nev/wardrobe/
assets/nev/accessories/
assets/nev/_contact/
projects/*/clips/
projects/*/output/
projects/*/tmp/
projects/*/audio/*.wav
projects/_archive/
*.mp4
*.wav
*.zip

__pycache__/
*.pyc
.DS_Store

# KEPT IN GIT on purpose (small, and they ARE the project):
#   assets/nev/face/          the 6-image identity set (~700KB) - generations need it
#   assets/nev/index.json     the measured metadata
#   assets/pillars/           the measured profiles - every gate reads these
#   projects/*/audio/*.json   declared cut lists (actual post-blend boundaries)
#   projects/*/analysis/*.png storyboards + evidence strips
#   ledgers/                  rejects + lessons - MERGE on conflict, never overwrite

# ---- desktop-side additions: keep the repo clean ----
assets/nev/*.jpeg
assets/nev/*.jpg
RESTORE/
_pre-sync-backup/
work/
output/
models/
assets/broll/
assets/sfx/
assets/shared/
assets/pillars/*/refs/*.mp4
ffmpeg-extracted/
*.png
!assets/pillars/**/*.png
!projects/*/analysis/*.png
*.spec

# ---- asset bank (added 2026-08-08) ----
# The measured SFX/foley bank is 353MB of audio. Same rule as refs and bgm:
# the AUDIO stays out, the MEASUREMENTS stay in. bank_index.json IS the bank -
# the folders are just where the bytes sit, and they re-download from the zip.
assets/bank/**/*.flac
assets/bank/**/*.aiff
assets/bank/**/*.ogg
!assets/bank/bank_index.json
!assets/bank/bank.py
!assets/bank/*.md

# rolling backups - local safety copies, not history
_backup_*/
